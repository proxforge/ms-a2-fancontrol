[Unit]
Description=Fan control for Minisforum MS-A2 by NVMe and RAM temperature
Documentation=https://github.com/proxforge/ms-a2-fancontrol
After=systemd-modules-load.service

[Service]
Type=simple
ExecStart=/usr/sbin/ms-a2-fancontrol run
# Regular stop: firmware levels; crash or error: emergency level until the restart
ExecStopPost=-/usr/sbin/ms-a2-fancontrol stop-post
Restart=on-failure
RestartSec=10
# Unknown device or firmware (exit 3): nothing was written, restarting would only repeat the check
RestartPreventExitStatus=3

[Install]
WantedBy=multi-user.target
